# =============================================================================
# SupportDesk AI — BACKEND environment variables (EXAMPLE)
# =============================================================================
# Copy this file to `.env` in the same folder and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit real keys, secrets, or passwords.
#
# Only the variables in the "PHASE 1" block are read by the code today.
# The later blocks are commented out on purpose so the server does not
# demand credentials for features that do not exist yet. We will uncomment
# them phase by phase.
# =============================================================================

# --- PHASE 1: server ---------------------------------------------------------
# Which mode the app runs in: development | test | production
NODE_ENV=development

# Port the Express server listens on.
PORT=5000

# Browser origin allowed to call this API (the Vite dev server).
CORS_ORIGIN=http://localhost:5173


# --- PHASE 2: databases (not read yet) ---------------------------------------
# PostgreSQL owns relational data: users, organizations, roles.
# POSTGRES_URL=postgresql://supportdesk:change_me_locally@localhost:5432/supportdesk

# MongoDB owns document data: tickets, messages, conversations, KB docs, AI logs.
# MONGO_URL=mongodb://supportdesk:change_me_locally@localhost:27017/supportdesk?authSource=admin


# --- PHASE 3: authentication (not read yet) ----------------------------------
# Long random string. Generate one with:  openssl rand -base64 48
# JWT_SECRET=
# JWT_EXPIRES_IN=1d


# --- PHASE 7: LLM (not read yet) ---------------------------------------------
# Anthropic API key — server-side only. Never ship this to the browser.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- PHASE 10: embeddings for RAG (not read yet) -----------------------------
# Anthropic does not offer an embeddings endpoint, so RAG needs a separate
# embedding source. See docs/Architecture.md — decision still open.
# EMBEDDING_PROVIDER=
# EMBEDDING_API_KEY=
