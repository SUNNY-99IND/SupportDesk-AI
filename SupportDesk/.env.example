# =============================================================================
# SupportDesk AI — root example environment file
# =============================================================================
# This file is COMMITTED and contains no real secrets.
# Copy it when you need it, but note that the app itself reads
# backend/.env and frontend/.env — not this file.
#
#   cp backend/.env.example  backend/.env
#   cp frontend/.env.example frontend/.env
#
# This root file exists so a new contributor can see every variable the
# system uses in one place, and so docker-compose can pick up DB credentials.
# =============================================================================

# --- Local database credentials used by docker-compose.yml ---------------
POSTGRES_USER=supportdesk
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=supportdesk

MONGO_INITDB_ROOT_USERNAME=supportdesk
MONGO_INITDB_ROOT_PASSWORD=change_me_locally
